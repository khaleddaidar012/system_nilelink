# ==============================================================================
# NileLink Portal Environment Configuration
# ==============================================================================

# Database Connection (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/nilelink

# Default remains MongoDB. D1 is an opt-in LOCAL migration preview only.
# Production activation is blocked until all domains and backup are migrated.
DATABASE_PROVIDER=mongodb
D1_MIGRATION_PREVIEW=false
# local disk laboratory, or isolated R2 bindings (never a production bucket).
D1_STORAGE_MODE=local
# local files in Node, or the fixed ASSETS binding in Workers.
PDF_ASSET_MODE=local
# Older local-preview flag remains supported when D1_MIGRATION_PREVIEW is absent.
D1_ACCOUNTS_PREVIEW=false

# JWT & Authentication Secrets
JWT_SECRET=replace-with-a-new-random-secret
AUTH_SECRET=replace-with-a-new-random-secret

# Cron Job Secret (for /api/cron/check-expiries)
CRON_SECRET=replace-with-a-new-random-secret

# Base App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Delivery (SMTP Settings - Optional for local dev)
EMAIL_FROM=no-reply@nilelink.com
EMAIL_SERVER_HOST=smtp.mailtrap.io
EMAIL_SERVER_PORT=2525
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# WhatsApp Business Cloud API (Optional for local dev)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/your_phone_number_id/messages
WHATSAPP_API_TOKEN=your_whatsapp_bearer_token

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=nilelink-documents
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Windows Backup Agent & Cloudflare Access (Worker secrets / server-side only)
# For local dev against mock/local agent: BACKUP_AGENT_URL=http://127.0.0.1:8787
# For production via Cloudflare Tunnel:
BACKUP_AGENT_URL=https://backup-agent.nilelinklogistics.com
BACKUP_AGENT_KEY_ID=k1
BACKUP_AGENT_HMAC_SECRET=your_backup_agent_hmac_secret_minimum_32_characters
CF_ACCESS_CLIENT_ID=your_cloudflare_access_service_token_client_id.access
CF_ACCESS_CLIENT_SECRET=your_cloudflare_access_service_token_client_secret
