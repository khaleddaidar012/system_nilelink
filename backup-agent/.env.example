# Nile Link Backup Agent — configuration NAMES only. Never commit real values.
# On the server, put real values in C:\NileLink\config\agent.env (ACL: service account + Administrators)
# or in machine-level environment variables.

# Where backups live
BACKUP_ROOT=C:\NileLink\Backups

# HTTP bind (keep loopback; exposure is via Cloudflare Tunnel only)
AGENT_BIND=127.0.0.1
AGENT_PORT=8787

# MongoDB Database Tools directory (folder containing mongodump.exe / mongorestore.exe). Empty = use PATH
MONGO_TOOLS_DIR=

# Database to back up and a human label stored in metadata (never a URI)
MONGO_DB_NAME=nilelink
MONGO_SOURCE_LABEL=atlas-cluster0

# Connection string for the backup user. Prefer a file with restricted ACL over a plain env var.
MONGO_URI_FILE=C:\NileLink\config\mongo-uri.txt
# MONGODB_URI=            # alternative to MONGO_URI_FILE (less safe)

# Request signing keys (Task 07): JSON like {"k1":"<random 32+ bytes hex>"}
# AGENT_HMAC_KEYS=

# Behaviour
LOG_LEVEL=info
DUMP_TIMEOUT_MINUTES=30
MIN_FREE_GB=1
MIN_ARCHIVE_BYTES=1024
REQUIRED_COLLECTIONS=users,customers
VERIFY_WITH_DRYRUN=false
RETENTION_AUTOMATIC_COUNT=30

# Scheduler (Task 05)
BACKUP_SCHEDULE_TIME=21:00
BACKUP_TIMEZONE=Africa/Cairo
SCHEDULER_ENABLED=true
MISSED_RUN_GRACE_MINUTES=180

# Retention (Task 13)
RETENTION_SAFETY_MIN_COUNT=3
RETENTION_SAFETY_MAX_AGE_DAYS=30
RETENTION_MIN_FREE_GB=2

# --- MailEnable monitoring (all optional; defaults shown) ---
# Only needed if auto-discovery (registry / service path / default folders) cannot find the install.
# MAILENABLE_PATH=C:\Program Files (x86)\Mail Enable
# MAILENABLE_BADMAIL_PATH=C:\Program Files (x86)\Mail Enable\Bad Mail\Messages
# MAILENABLE_HOST=127.0.0.1
# MAILENABLE_SMTP_PORT=25
# MAILENABLE_IMAP_PORT=143
# MAILENABLE_SMTP_SERVICE=MESMTPCS
# MAILENABLE_IMAP_SERVICE=MEIMAPS
