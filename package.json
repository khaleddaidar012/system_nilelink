{
  "name": "nilelink-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npx tsx --test tests/**/*.test.ts",
    "test:d1": "node --import ./tests/d1/register-typescript.mjs --test tests/d1/*.test.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.d1.local.jsonc",
    "d1:export-mongo": "node scripts/d1/export-mongo.mjs",
    "d1:rehearse": "node scripts/d1/rehearse.mjs",
    "d1:backup:local": "node scripts/d1/backup.mjs create-local",
    "d1:restore:rehearse": "node scripts/d1/backup.mjs rehearse",
    "d1:delivery:preview": "node --import ./tests/d1/register-typescript.mjs scripts/d1/delivery-preview.mjs",
    "d1:build:audit": "node scripts/d1/build-audit.mjs",
    "d1:worker:audit": "node scripts/d1/build-audit.mjs --worker",
    "d1:pdf:audit": "node scripts/d1/pdf-runtime-audit.mjs",
    "d1:files:inventory": "node scripts/d1/file-inventory.mjs",
    "d1:finance:audit": "node scripts/d1/financial-audit.mjs",
    "d1:files:verify-source": "node scripts/d1/verify-source-r2.mjs",
    "d1:files:backup": "node scripts/d1/file-backup.mjs",
    "d1:staging:import": "node scripts/d1/import-staging.mjs",
    "d1:staging:restore:rehearse": "node scripts/d1/rehearse-sql-export.mjs",
    "d1:files:transfer": "node --use-system-ca scripts/d1/transfer-r2.mjs",
    "d1:worker:staging:prepare": "node scripts/d1/prepare-worker-staging.mjs",
    "d1:worker:staging:smoke": "node scripts/d1/smoke-worker-staging.mjs",
    "d1:staging:prepare": "node scripts/d1/staging-target.mjs",
    "cf-build": "opennextjs-cloudflare build",
    "cf-preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@headlessui/react": "^1.7.19",
    "@hookform/resolvers": "^5.4.0",
    "@opennextjs/cloudflare": "1.20.0",
    "@types/pdfkit": "^0.17.6",
    "bidi-js": "^1.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.7.4",
    "naqqash": "^0.2.0",
    "next": "16.2.10",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.20.2",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-aria": "^3.52.1",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "react-icons": "^5.7.0",
    "react-is": "^19.3.0",
    "react-stately": "^3.50.0",
    "recharts": "^3.9.2",
    "resend": "^6.28.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "esbuild": "0.25.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "miniflare": "4.20260721.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.0.0"
  }
}
