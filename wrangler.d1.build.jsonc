{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Build inspection only. Never deploy this zero-ID laboratory configuration.
  "name": "nilelink-d1-build-audit",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env", "enable_nodejs_fs_module"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "DATABASE_PROVIDER": "d1", "D1_MIGRATION_PREVIEW": "true", "D1_STORAGE_MODE": "r2-preview", "PDF_ASSET_MODE": "binding" },
  "r2_buckets": [
    { "binding": "D1_PREVIEW_FILES", "bucket_name": "nilelink-d1-preview-local", "remote": false },
    { "binding": "D1_SOURCE_FILES", "bucket_name": "nilelink-d1-source-fixture", "remote": false }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "nilelink-d1-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations/d1" }]
}
